# Optional local Python settings. Copy to .env and export these variables in your shell;
# Django does not load .env files automatically. Docker Compose supplies its demo settings.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_PATH=./db.sqlite3
# Set a long random secret for a non-demo deployment.
DJANGO_SECRET_KEY=
